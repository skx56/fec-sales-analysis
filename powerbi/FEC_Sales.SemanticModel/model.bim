            "sourceColumn": "unit_price",
            "summarizeBy": "none"
          },
          {
            "name": "unit_cost",
            "dataType": "double",
            "sourceColumn": "unit_cost",
            "summarizeBy": "none"
          },
          {
            "name": "freight_per_unit",
            "dataType": "double",
            "sourceColumn": "freight_per_unit",
            "summarizeBy": "none"
          },
          {
