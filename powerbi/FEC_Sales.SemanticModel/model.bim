      {
        "name": "fact_sales",
        "columns": [
          {
            "name": "sale_id",
            "dataType": "string",
            "sourceColumn": "sale_id",
            "summarizeBy": "none"
          },
          {
            "name": "invoice_id",
            "dataType": "string",
            "sourceColumn": "invoice_id",
            "summarizeBy": "none"
          },
          {
            "name": "date_key",
            "dataType": "int64",
            "sourceColumn": "date_key",
            "summarizeBy": "none"
          },
          {
            "name": "product_id",
            "dataType": "string",
            "sourceColumn": "product_id",
            "summarizeBy": "none"
          },
          {
            "name": "customer_id",
            "dataType": "string",
            "sourceColumn": "customer_id",
            "summarizeBy": "none"
          },
          {
            "name": "supplier_id",
            "dataType": "string",
            "sourceColumn": "supplier_id",
            "summarizeBy": "none"
          },
          {
            "name": "quantity",
            "dataType": "double",
            "sourceColumn": "quantity",
            "summarizeBy": "sum"
          },
          {
            "name": "return_qty",
            "dataType": "double",
            "sourceColumn": "return_qty",
            "summarizeBy": "sum"
          },
          {
            "name": "net_qty",
            "dataType": "double",
            "sourceColumn": "net_qty",
            "summarizeBy": "sum"
          },
          {
