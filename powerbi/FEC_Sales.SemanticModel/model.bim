                "    Typed = Table.TransformColumnTypes(Promoted, {{\"purchase_id\", type text}, {\"po_id\", type text}, {\"date_key\", Int64.Type}, {\"supplier_id\", type text}, {\"product_id\", type text}, {\"qty_ordered\", type number}, {\"qty_received\", type number}, {\"qty_defective\", type number}, {\"unit_cost\", type number}, {\"purchase_value\", type number}, {\"contracted_lead_days\", Int64.Type}, {\"actual_lead_days\", Int64.Type}, {\"on_time_flag\", Int64.Type}})",
