          }
        ],
        "partitions": [
          {
            "name": "dim_date",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(\"/Users/saksham56/Developer/fec-sales-analysis/data/powerbi/dim_date.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Promoted, {{\"date_key\", Int64.Type}, {\"date\", type date}, {\"calendar_year\", Int64.Type}, {\"quarter\", Int64.Type}, {\"month\", Int64.Type}, {\"month_name\", type text}, {\"month_start\", type date}, {\"fy_year\", Int64.Type}, {\"fy_label\", type text}, {\"fiscal_quarter\", Int64.Type}, {\"fiscal_month\", Int64.Type}})",
                "in",
